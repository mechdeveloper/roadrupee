# RoadRupee environment template. Copy to .env and fill in your own values. NEVER commit .env.

# Your own Anthropic API key (get one at console.anthropic.com). Needed only for Claude features and deploy.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Needed only if your API key is not scoped to a workspace (sent as the anthropic-workspace-id header).
ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id-here

# Model for fast, user-facing answers (trace replies, explanations, Ask the auditor).
CLAUDE_MODEL_LIVE=claude-sonnet-5-5

# Model for careful extraction (messy multilingual complaints, flag review).
CLAUDE_MODEL_EXTRACT=claude-opus-5-5

# Where the Next.js proxy forwards /api/* (read at runtime). docker compose overrides this to http://backend:8000.
BACKEND_URL=http://localhost:8000

# Optional: dataset folder for the backend (default: ./data; the Docker image sets /app/data).
# DATA_DIR=./data

# Optional: where the backend writes its JSON snapshot at startup (default: backend/.cache).
# CACHE_DIR=./backend/.cache

# Optional deploy overrides for infra/deploy-aca.sh (defaults shown): resource group.
# RG=roadrupee-rg

# Optional deploy override: Azure region.
# LOCATION=centralindia

# Optional deploy override: Container Apps environment name.
# ENV_NAME=roadrupee-env

# Optional deploy override: backend app name (internal ingress).
# BACKEND_APP=roadrupee-backend

# Optional deploy override: frontend app name (external ingress).
# FRONTEND_APP=roadrupee-frontend

# Optional deploy override: container registry name (globally unique; default derives from your subscription).
# ACR_NAME=

# Optional deploy override: image tag (default: short git commit).
# TAG=
